{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "千叶新页",
  "version": "1.0.0",
  "identifier": "io.github.gaoteng189.qiansnewpage",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["www/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}

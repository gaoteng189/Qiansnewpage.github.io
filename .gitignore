# 留言板运行时数据（由 server.js 动态生成）
messages.json

# 可执行文件（体积大，CF Pages 单文件限制 25MB，不提交）
*.exe

# Node.js
node_modules/

# 端口配置
.server-port

# Qt 部署产物与运行时依赖（在 bin 目录）
bin/*.dll
bin/platforms/
bin/imageformats/
bin/styles/
bin/tls/
bin/generic/
bin/networkinformation/

# 编译中间产物
start-server-res.o
start-server-core.exe
bin/start-server-core.exe
bin/start-server-core-new.exe
stub.o
stub-icon.o
stub-res.o
stub-resources.rc
payload.bin
payload.o
.qmake.stash
Makefile
Makefile.Release
Makefile.Debug

# 根目录运行副本（编译后复制，方便双击运行，勿提交）
/start-server.exe

# Tailscale 证书（含私钥，勿提交）
*.crt
*.key

# 调试日志
funnel-debug.log
console.log
